# Copy this file to .env and adjust as needed. Values below are dummy
# development defaults matched to docker-compose.yml.

POSTGRES_USER=shiftlog
POSTGRES_PASSWORD=shiftlog_dev_password
POSTGRES_DB=shiftlog

# Full connection string the API uses. When running via docker-compose the
# host is the "db" service name; when running the API locally against a
# dockerized Postgres, use localhost instead.
DATABASE_URL=postgresql://shiftlog:shiftlog_dev_password@localhost:5432/shiftlog

# How often (seconds) the background job checks for shifts starting soon.
UPCOMING_SHIFT_CHECK_INTERVAL_SECONDS=60

# How far ahead (minutes) counts as "starting soon" for the background job.
UPCOMING_SHIFT_LOOKAHEAD_MINUTES=30
